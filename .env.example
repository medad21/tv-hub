# signal = alerts only | paper = virtual trading | live = real orders (crypto spot)
MODE=signal

# ---- What to watch ----
# Symbols the bot watches and sends signals for. TradingView format EXCHANGE:TICKER, separated by commas.
# Empty = the built-in list in config.js (25 symbols). Example to focus on two markets:
#   SYMBOLS=BINANCE:BTCUSDT,OANDA:XAUUSD
SYMBOLS=
# Candle size: 1, 5, 15, 30, 60, 240, D, W   (empty = 15)
TIMEFRAME=

# Reach the dashboard from your phone / a server: set HOST=0.0.0.0 AND a strong password.
# (With HOST=0.0.0.0 the app refuses to start without DASH_PASSWORD.)
HOST=127.0.0.1
DASH_PASSWORD=

# Telegram alerts + remote control (/status /halt /resume /panic). Bot from @BotFather, id from @userinfobot
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
# Easier: the dashboard panel «اتصال تلگرام» (token, chat id and an optional HTTP proxy are saved there and win over these lines)
# TELEGRAM_PROXY=http://127.0.0.1:10809
# Forward evidence report (real results vs backtest of the same weeks), sent to Telegram: every N days (default 7; off = disabled)
EVIDENCE_EVERY_DAYS=
# how many days back each report looks (default 30)
EVIDENCE_WINDOW_DAYS=
# Daily summary in Telegram: hour in UTC (0-23); empty = 20 (23:30 Iran time); off = disabled
DAILY_SUMMARY_HOUR_UTC=

# ---- Live trading (MODE=live) ----
LIVE_CONFIRM=NO        # must be YES to allow real orders
EXCHANGE_TESTNET=NO    # YES = sandbox/testnet keys (Binance, Bybit, OKX demo...). If an exchange has no sandbox the bot refuses to trade.
# EXCHANGE_STOPS=NO  # old way to turn the exchange-side stop off. Easier: the switch «استاپ سمت صرافی» on the dashboard (it wins over this line). Default = ON.

# Fill in ONLY the exchanges you use. Keys with TRADE permission only, NEVER withdraw permission.
# An exchange without keys stays signal-only. OKX / KuCoin / Bitget also need a PASSPHRASE.
BINANCE_KEY=
BINANCE_SECRET=
BYBIT_KEY=
BYBIT_SECRET=
OKX_KEY=
OKX_SECRET=
OKX_PASSPHRASE=
KUCOIN_KEY=
KUCOIN_SECRET=
KUCOIN_PASSPHRASE=
KRAKEN_KEY=
KRAKEN_SECRET=
COINBASE_KEY=
COINBASE_SECRET=
BITGET_KEY=
BITGET_SECRET=
BITGET_PASSPHRASE=
GATEIO_KEY=
GATEIO_SECRET=
MEXC_KEY=
MEXC_SECRET=

# ---- US stocks (Alpaca) ----
# Get free keys (paper trading included) at https://alpaca.markets
# ALPACA_PAPER=NO switches to real money; default is paper.
ALPACA_KEY=
ALPACA_SECRET=
ALPACA_PAPER=YES

# ---- Forex / gold (OANDA) ----
# Get a free practice account and token at https://developer.oanda.com
# OANDA_PRACTICE=NO switches to real money; default is the practice (demo) account.
OANDA_TOKEN=
OANDA_ACCOUNT_ID=
OANDA_PRACTICE=YES

# ---- AI helper (optional): turns a plain-words idea into a strategy you then backtest ----
# Nothing needs this: without a key the AI button just says "set a key first", and the "no key" way (paste into any chatbot) still works.
# You can also type the key in the dashboard (AI section > settings); a value here wins over the dashboard one.
#   AI_PROVIDER=anthropic          anthropic = Claude | openai = anything OpenAI-compatible (OpenAI, Gemini, DeepSeek, OpenRouter, local Ollama)
#   AI_MODEL=                      the model name from YOUR provider
#   AI_BASE_URL=                   only for openai-compatible services, e.g. http://localhost:11434/v1 for Ollama (no key needed there)
AI_API_KEY=
# safety cap on AI requests per hour (default 30)
AI_MAX_PER_HOUR=

# ---- Research ledger (optional) ----
# The comparison counts how many ideas you recently tried on a symbol (runs, Sweeps, saved strategies) and corrects its
# "is this just luck?" numbers for that. Only the last N days count (default 90).
TRIAL_WINDOW_DAYS=
